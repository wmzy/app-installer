<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>mihomo.clean-log</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>MIHOMO_HOME_PLACEHOLDER/bin/clean-log.sh</string>
    </array>

    <!-- 每天 04:30 检查一次, 超过 100MB 才实际轮转 -->
    <key>StartCalendarTimer</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
</dict>
</plist>
