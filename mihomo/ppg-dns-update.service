[Unit]
Description=Refresh ppg airport entry IPs (one-shot)
After=network-online.target mihomo.service
Wants=network-online.target

[Service]
Type=oneshot
# 入口是安装到 /usr/local/sbin 的副本 (bin_t); 不能直接指向 /home 下的
# 仓库脚本: SELinux 禁止 init_t execute user_home_t (203/EXEC 失败)
ExecStart=/usr/local/sbin/ppg-dns-update
